# Copie para .env (o `pnpm invoke` carrega o .env via dotenv).
# Em produção (Lambda) estas variáveis vêm dos parâmetros do template.yaml.

# --- Obrigatórias ---

# String de conexão do MongoDB. Local: mongodb://127.0.0.1:27017
# Produção: string do MongoDB Atlas (mongodb+srv://<usuario>:<senha>@<cluster>/...)
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do banco. Precisa ser o mesmo usado pelo crawler (raw_crawls) e pela API (eventos).
MONGODB_DB_NAME=role_sc

# Chave da API da Groq (https://console.groq.com/keys).
# Com GROQ_BASE_URL apontando para um servidor falso, qualquer valor não vazio serve.
GROQ_API_KEY=<sua-chave-groq>

# --- Opcionais ---

# Modelo usado na extração. Padrão no código e no template: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Endpoint da Groq, lido diretamente pelo groq-sdk. Padrão: https://api.groq.com
# Só defina para usar um servidor compatível/simulado (ele precisa responder em
# POST <GROQ_BASE_URL>/openai/v1/chat/completions).
# GROQ_BASE_URL=http://127.0.0.1:4112

# Nível de log do groq-sdk (debug, info, warn, error, off). Lido pelo SDK.
# GROQ_LOG=debug

# Fuso do processo. As datas do LLM (YYYY-MM-DD) viram meia-noite no fuso local;
# a Lambda roda em UTC. Use UTC para gravar datas iguais às de produção.
# TZ=UTC
